# Websters deployment routing (Traefik)
DOMAIN=spacerunner.websters.at
ROUTER_NAME=spacerunner
TRAEFIK_NETWORK=proxy

# Database Config
DB_HOST=database
DB_PORT=3306
DB_NAME=spacerunner
DB_USER=spacerunner
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Multiplayer server (Node): allowed browser origin for Socket.IO.
# Defaults to https://spacerunner.websters.at when unset.
# CORS_ORIGIN=https://spacerunner.websters.at
